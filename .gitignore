# Xcode / project generation
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
*.xcuserstate
*.xccheckout
*.moved-aside

# Swift Package Manager
.build/
Packages/
*.resolved

# whisper.cpp build artifacts (submodule source is tracked via .gitmodules, not its build output)
vendor/whisper.cpp/build/
vendor/whisper.cpp/build-apple/
build-apple/
*.xcframework/

# Model weights - never commit these, they are 250MB-1GB+ each
*.bin
*.ggml
*.gguf
Models/*.bin

# CI build output
build/
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
exportOptions-resolved.plist

# Secrets staged locally for signing (never commit these)
*.p8
*.p12
*.mobileprovision
*.cer
*.keychain
*.keychain-db

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python (model conversion scripts)
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log
